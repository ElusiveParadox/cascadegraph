APP_ENV=development
# PORT is supplied by the managed artifact workflow.
CASCADEGRAPH_DB_PATH=cascadegraph.sqlite3
LLM_ENABLED=true
LLM_PROVIDER=replit_openai
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Optional direct provider settings; configure credentials through Secrets.
# LLM_API_KEY=
# LLM_BASE_URL=
# Replit provisions AI_INTEGRATIONS_OPENAI_BASE_URL/API_KEY automatically.
